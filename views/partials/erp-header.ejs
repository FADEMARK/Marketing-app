<%
// Header propio de YonkSuite: logo + color de marca del negocio (capturados
// en Configuración > Empresa) y un menú horizontal simple con las secciones
// a las que ese actor (dueño o empleado) tiene acceso — estilo barra de una
// app de escritorio (NetSuite, etc.), separado a propósito de la barra de
// MarketingHub (ver services/middleware.js: req.erpActor).
//
// "Ventas" e "Inventario" son dropdowns (Nueva venta/Ver ventas/Cotizaciones
// y Meter auto/Visualizar inventario, respectivamente) para que abrir
// cualquiera de esas acciones sea un clic desde CUALQUIER pantalla, no solo
// desde dentro de un vehículo — pedido explícito del negocio. El link
// "padre" de cada dropdown también navega directo a la vista de lista, así
// que en móvil (donde no hay hover) igual se llega a algo útil con un solo
// tap, aunque no se vea el desplegable.
//
// currentSection lo manda cada vista para resaltar la pestaña activa: uno de
// "dashboard" | "core-ventas" | "core-compras" | "ventas" | "cotizaciones" |
// "vehiculos" | "inventario" | "contabilidad" | "clientes" | "proveedores" |
// "empleados" | "reportes" | "configuracion" | null.
//
// "Ventas ▾"/"Compras ▾" (core-ventas/core-compras) son el motor genérico de
// erpTransactions (Cotización→Orden→Ejecución→Factura→Nota de crédito) y
// SIEMPRE aparecen, tenga o no el negocio el módulo de vehículos. "Vehículos"
// (Meter auto/Ventas de vehículos/Cotizaciones de vehículos) es del módulo
// YonkSuite y solo aparece si moduleYonksuiteEnabled — es una cadena
// completamente aparte (erp_vehicles/erp_parts/erp_sales/erp_quotes, NO
// erp_transactions) porque nació antes del core genérico y sigue viva para
// los negocios que sí son yonkes. "Inventario" (Artículos/Ajuste/Visualizar/
// Ubicaciones) es del core genérico y también SIEMPRE aparece — son
// catálogos distintos (erp_items vs erp_vehicles/erp_parts) a propósito.
const _section = typeof currentSection !== "undefined" ? currentSection : null;
const _erpActor = typeof erpActor !== "undefined" ? erpActor : null;
const _searchQ = typeof searchGlobalQuery !== "undefined" ? searchGlobalQuery : "";
const _roleLabels = { owner: "Dueño", admin: "Admin", ventas: "Ventas", compras: "Compras", ventas_admin: "Ventas / Admin" };
%>
  <header class="erp-topbar" style="--erp-color: <%= (_erpActor && _erpActor.brandColorPrimary) || '#1B2A4A' %>;">
    <a href="/erp" class="erp-brand">
      <% if (_erpActor && _erpActor.logoData) { %>
        <img src="<%= _erpActor.logoData %>" alt="" class="erp-brand-logo" />
      <% } else { %>
        <span class="erp-brand-fallback">🔧</span>
      <% } %>
      <span class="erp-brand-text">
        <strong>YonkSuite</strong>
        <span><%= (_erpActor && _erpActor.businessName) || "" %></span>
      </span>
    </a>
    <nav class="erp-topnav">
      <a href="/erp" class="<%= _section === 'dashboard' ? 'active' : '' %>">Dashboard</a>

      <div class="erp-nav-item">
        <a href="/erp/core/ventas" class="<%= _section === 'core-ventas' ? 'active' : '' %>">Ventas ▾</a>
        <div class="erp-nav-dropdown">
          <a href="/erp/core/ventas">Ver todo</a>
          <a href="/erp/core/ventas/cotizacion">Cotizaciones</a>
          <a href="/erp/core/ventas/orden_venta">Órdenes de venta</a>
          <a href="/erp/core/ventas/ejecucion_venta">Ejecuciones de pedido</a>
          <a href="/erp/core/ventas/factura_venta">Facturas</a>
          <a href="/erp/core/ventas/nota_credito_venta">Notas de crédito</a>
        </div>
      </div>

      <div class="erp-nav-item">
        <a href="/erp/core/compras" class="<%= _section === 'core-compras' ? 'active' : '' %>">Compras ▾</a>
        <div class="erp-nav-dropdown">
          <a href="/erp/core/compras">Ver todo</a>
          <a href="/erp/core/compras/orden_compra">Órdenes de compra</a>
          <a href="/erp/core/compras/ejecucion_compra">Ejecuciones de pedido</a>
          <a href="/erp/core/compras/factura_compra">Facturas</a>
          <a href="/erp/core/compras/nota_credito_compra">Notas de crédito</a>
        </div>
      </div>

      <div class="erp-nav-item">
        <a href="/erp/inventario" class="<%= _section === 'inventario' ? 'active' : '' %>">Inventario ▾</a>
        <div class="erp-nav-dropdown">
          <a href="/erp/inventario">Visualizar inventario</a>
          <a href="/erp/inventario/articulos">Artículos</a>
          <a href="/erp/inventario/ajustes">Ajuste de inventario</a>
          <% if (_erpActor && _erpActor.canManageEmployees) { %>
            <a href="/erp/configuracion/ubicaciones">Ubicaciones</a>
          <% } %>
        </div>
      </div>

      <% if (_erpActor && _erpActor.moduleYonksuiteEnabled) { %>
        <div class="erp-nav-item">
          <a href="/erp/vehiculos" class="<%= (_section === 'vehiculos' || _section === 'ventas' || _section === 'cotizaciones') ? 'active' : '' %>">Vehículos ▾</a>
          <div class="erp-nav-dropdown">
            <% if (_erpActor.canCompras) { %>
              <a href="/erp/vehicles/new">🚗 Meter auto</a>
            <% } %>
            <a href="/erp/vehiculos">Visualizar inventario de vehículos</a>
            <% if (_erpActor.canVentas) { %>
              <a href="/erp/ventas/new">🧾 Nueva venta de vehículo</a>
            <% } %>
            <a href="/erp/ventas">Ventas de vehículos</a>
            <a href="/erp/cotizaciones">Cotizaciones de vehículos</a>
          </div>
        </div>
      <% } %>

      <% if (_erpActor && _erpActor.canManageEmployees) { %>
        <div class="erp-nav-item">
          <a href="/erp/contabilidad/polizas" class="<%= _section === 'contabilidad' ? 'active' : '' %>">Contabilidad ▾</a>
          <div class="erp-nav-dropdown">
            <a href="/erp/contabilidad/polizas">Pólizas de diario</a>
            <a href="/erp/contabilidad/polizas/nueva">+ Nueva póliza</a>
            <a href="/erp/configuracion/cuentas-contables">Cuentas contables</a>
          </div>
        </div>
      <% } %>

      <a href="/erp/clientes" class="<%= _section === 'clientes' ? 'active' : '' %>">Clientes</a>
      <a href="/erp/proveedores" class="<%= _section === 'proveedores' ? 'active' : '' %>">Proveedores</a>
      <% if (_erpActor && _erpActor.erpPlan === 'plus' && _erpActor.canManageEmployees) { %>
        <a href="/erp/empleados" class="<%= _section === 'empleados' ? 'active' : '' %>">Empleados</a>
      <% } %>
      <% if (_erpActor && _erpActor.canManageEmployees) { %>
        <a href="/erp/reportes" class="<%= _section === 'reportes' ? 'active' : '' %>">Reportes</a>
        <a href="/erp/configuracion" class="<%= _section === 'configuracion' ? 'active' : '' %>">Configuración</a>
      <% } %>
    </nav>

    <form method="GET" action="/erp/buscar" class="erp-search">
      <input type="text" name="q" value="<%= _searchQ %>" placeholder="Buscar inventario, clientes, cotizaciones, ventas..." />
      <button type="submit" title="Buscar">🔎</button>
    </form>

    <div class="erp-topbar-user">
      <% if (_erpActor) { %>
        <span><%= _erpActor.name %></span>
        <span class="erp-role-pill"><%= _roleLabels[_erpActor.role] || _erpActor.role %></span>
      <% } %>
      <form method="POST" action="/erp/logout" class="inline-form">
        <button type="submit">Cerrar sesión</button>
      </form>
    </div>
  </header>
