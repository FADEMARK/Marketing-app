<!DOCTYPE html>
<html lang="es">
<head>
  <title>Cuentas contables — Configuración</title>
  <%- include('partials/head') %>
</head>
<body class="erp-shell">
  <%- include('partials/erp-header', { currentSection: 'configuracion' }) %>

  <main class="page narrow">
    <a href="/erp/configuracion" class="back-link">&larr; Volver a Configuración</a>
    <h1>Cuentas contables</h1>
    <p class="muted small">
      Catálogo de cuentas (activo, pasivo, capital, ingreso, costo, gasto) que usarás en
      Contabilidad &gt; Pólizas de diario para registrar cargos y abonos.
    </p>

    <% if (saved) { %>
      <div class="alert alert-success">Cambios guardados.</div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (accounts.length === 0) { %>
      <div class="detail-box">
        <h3>Empieza rápido</h3>
        <p class="muted small">
          Da de alta de un clic las 16 cuentas más usuales para un negocio mexicano chico/mediano
          (Caja, Bancos, Clientes, IVA acreditable/trasladado, Proveedores, Capital social,
          Ventas, Costo de ventas, Gastos generales, Sueldos, Renta...). Después puedes
          renombrarlas, desactivarlas o agregar las tuyas.
        </p>
        <form method="POST" action="/erp/configuracion/cuentas-contables/sembrar-sat">
          <button type="submit" class="btn-primary full-width">🇲🇽 Sembrar cuentas usuales del SAT</button>
        </form>
      </div>
    <% } %>

    <div class="detail-box" style="margin-top:20px;">
      <h3>Agregar cuenta</h3>
      <form method="POST" action="/erp/configuracion/cuentas-contables" class="card-form">
        <div class="two-col">
          <label>Código
            <input type="text" name="code" required placeholder="101" />
          </label>
          <label>Nombre
            <input type="text" name="name" required placeholder="Caja" />
          </label>
        </div>
        <label>Tipo de cuenta
          <select name="account_type" required>
            <% Object.values(accountTypes).forEach(function(type) { %>
              <option value="<%= type %>"><%= accountTypeLabels[type] %></option>
            <% }); %>
          </select>
        </label>
        <button type="submit" class="btn-primary full-width">+ Agregar</button>
      </form>
    </div>

    <div class="detail-box" style="margin-top:20px;">
      <h3>Tus cuentas</h3>
      <% if (accounts.length === 0) { %>
        <p class="muted">Todavía no has agregado ninguna cuenta.</p>
      <% } else { %>
        <table class="admin-table">
          <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Estado</th><th></th></tr></thead>
          <tbody>
            <% accounts.forEach(function(a) { %>
              <tr>
                <td><%= a.code %></td>
                <td>
                  <%= a.name %>
                  <% if (a.is_default) { %><span class="status-badge status-aprobado" style="margin-left:6px;">SAT</span><% } %>
                </td>
                <td class="muted small"><%= accountTypeLabels[a.account_type] || a.account_type %></td>
                <td>
                  <span class="status-badge <%= a.active ? 'status-aprobado' : 'status-pendiente_revision' %>">
                    <%= a.active ? 'Activo' : 'Inactivo' %>
                  </span>
                </td>
                <td>
                  <% if (!a.is_default) { %>
                    <form method="POST" action="/erp/configuracion/cuentas-contables/<%= a.id %>/toggle-active" class="inline-form">
                      <button type="submit" class="link-button"><%= a.active ? 'Desactivar' : 'Activar' %></button>
                    </form>
                  <% } else { %>
                    <span class="muted small">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</body>
</html>
