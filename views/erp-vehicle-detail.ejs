<!DOCTYPE html>
<html lang="es">
<head>
  <title><%= vehicle.brand %> <%= vehicle.model %> — ERP Yonkes</title>
  <%- include('partials/head') %>
</head>
<body class="erp-shell">
  <%- include('partials/erp-header', { currentSection: 'vehiculos' }) %>

  <main class="page narrow">
    <a href="/erp/vehiculos" class="back-link">&larr; Volver al inventario</a>

    <div class="page-header">
      <h1><%= vehicle.brand %> <%= vehicle.model %> <%= vehicle.year || '' %></h1>
      <span class="status-badge status-<%= vehicle.status %>"><%= VEHICLE_STATUS_LABELS[vehicle.status] || vehicle.status %></span>
    </div>

    <% if (saved) { %><div class="alert alert-success">Cambios guardados.</div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <!-- Estado de cuenta -->
    <div class="stat-box">
      <div>
        <span class="stat-label">Precio de compra</span>
        <span class="stat-value">$<%= Number(vehicle.purchase_price).toLocaleString('es-MX', {minimumFractionDigits:2}) %></span>
      </div>
      <div>
        <span class="stat-label">Vendido a la fecha</span>
        <span class="stat-value">$<%= Number(totalSold).toLocaleString('es-MX', {minimumFractionDigits:2}) %></span>
      </div>
      <div>
        <span class="stat-label">Ganancia / pérdida</span>
        <span class="stat-value <%= profit >= 0 ? 'positive' : 'negative' %>">
          <%= profit >= 0 ? '+' : '-' %>$<%= Math.abs(profit).toLocaleString('es-MX', {minimumFractionDigits:2}) %>
        </span>
      </div>
      <div>
        <span class="stat-label">Piezas</span>
        <span class="stat-value"><%= parts.filter(p => p.status === 'vendida').length %>/<%= parts.length %> vendidas</span>
      </div>
    </div>

    <!-- Datos del vehículo (primero, para que al abrir un vehículo lo primero
    que se vea sea su información — no las fotos) -->
    <% if (canCompras) { %>
    <div class="detail-box" style="margin-top:20px;">
      <h3>Datos del vehículo</h3>
      <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/update" class="card-form">
        <div class="two-col">
          <label>Marca
            <input type="text" name="brand" required value="<%= vehicle.brand %>" />
          </label>
          <label>Modelo
            <input type="text" name="model" required value="<%= vehicle.model %>" />
          </label>
        </div>
        <div class="two-col">
          <label>Año
            <input type="number" name="year" value="<%= vehicle.year || '' %>" />
          </label>
          <label>Color
            <input type="text" name="color" value="<%= vehicle.color || '' %>" />
          </label>
        </div>
        <div class="two-col">
          <label>VIN
            <input type="text" name="vin" value="<%= vehicle.vin || '' %>" />
          </label>
          <label>Placa
            <input type="text" name="plate" value="<%= vehicle.plate || '' %>" />
          </label>
        </div>
        <div class="two-col">
          <label>Precio de compra
            <input type="number" name="purchase_price" step="0.01" min="0" required value="<%= vehicle.purchase_price %>" />
          </label>
          <label>Fecha de compra
            <input type="date" name="purchase_date" value="<%= vehicle.purchase_date ? new Date(vehicle.purchase_date).toISOString().slice(0,10) : '' %>" />
          </label>
        </div>
        <label>Notas
          <textarea name="notes" rows="3"><%= vehicle.notes || '' %></textarea>
        </label>
        <button type="submit" class="btn-primary full-width">Guardar cambios</button>
      </form>

      <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/toggle-status" style="margin-top:12px;">
        <button type="submit" class="btn-secondary full-width">
          <%= vehicle.status === 'agotado' ? 'Reactivar (marcar en stock)' : 'Marcar como Agotado (dar de baja)' %>
        </button>
      </form>

      <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/delete" style="margin-top:12px;"
            onsubmit="return confirm('¿Borrar este vehículo y sus piezas? No se puede deshacer.');">
        <button type="submit" class="link-button" style="color:#B3261E;">🗑 Eliminar vehículo</button>
      </form>
    </div>
    <% } %>

    <!-- Fotos -->
    <div class="detail-box" style="margin-top:20px;">
      <h3>Fotos</h3>
      <% if (photos.length === 0) { %>
        <p class="muted small">Todavía no subes fotos de este vehículo.</p>
      <% } else { %>
        <div class="photo-grid">
          <% photos.forEach(function(photo) { %>
            <figure>
              <img src="<%= photo.photo_data %>" alt="" />
              <% if (canCompras) { %>
                <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/photos/<%= photo.id %>/delete"
                      onsubmit="return confirm('¿Borrar esta foto?');">
                  <button type="submit" title="Borrar foto">✕</button>
                </form>
              <% } %>
            </figure>
          <% }); %>
        </div>
      <% } %>
      <% if (canCompras && photos.length < MAX_VEHICLE_PHOTOS) { %>
        <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/photos" enctype="multipart/form-data" style="margin-top:12px; display:flex; gap:8px; align-items:center;">
          <input type="file" name="photos" accept="image/*" multiple />
          <button type="submit" class="btn-secondary">Agregar fotos</button>
        </form>
      <% } %>
      <% if (canCompras && photos.length > 0) { %>
        <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/analizar-ia" style="margin-top:12px;">
          <button type="submit" class="btn-secondary full-width">🤖 Analizar con IA (sugerir piezas)</button>
        </form>
      <% } %>
    </div>

    <!-- Sugerencias de IA -->
    <% if (canCompras && aiSuggestedParts && aiSuggestedParts.length > 0) { %>
      <div class="detail-box" style="margin-top:20px;">
        <h3>🤖 Piezas sugeridas por IA</h3>
        <p class="muted small">Revisa cada pieza, ajusta su estado si hace falta y marca las que quieras enviar al inventario.</p>
        <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/ai-checklist/enviar" class="card-form">
          <% aiSuggestedParts.forEach(function(sp, idx) { %>
            <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border);">
              <input type="checkbox" name="items[<%= idx %>][selected]" value="1" id="ai-part-<%= idx %>" style="width:auto;" />
              <input type="hidden" name="items[<%= idx %>][name]" value="<%= sp.name %>" />
              <input type="hidden" name="items[<%= idx %>][category]" value="<%= sp.category %>" />
              <label for="ai-part-<%= idx %>" style="flex:1; font-weight:400; margin:0;">
                <%= sp.name %> <span class="muted small">(<%= PART_CATEGORY_LABELS[sp.category] || sp.category %>)</span>
              </label>
              <select name="items[<%= idx %>][condition_grade]" style="width:130px;">
                <% Object.values(PART_CONDITIONS).forEach(function(c) { %>
                  <option value="<%= c %>" <%= sp.condition_grade === c ? 'selected' : '' %>><%= PART_CONDITION_LABELS[c] %></option>
                <% }); %>
              </select>
              <input type="number" name="items[<%= idx %>][asking_price]" step="0.01" min="0" placeholder="Precio"
                     value="<%= sp.suggested_price || '' %>" style="width:110px;" />
            </div>
          <% }); %>
          <button type="submit" class="btn-primary full-width" style="margin-top:12px;">Enviar seleccionadas a inventario</button>
        </form>
      </div>
    <% } %>

    <!-- Piezas -->
    <div class="detail-box" style="margin-top:20px;">
      <h3>Piezas (<%= parts.length %>)</h3>

      <% if (canCompras) { %>
      <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/parts" class="card-form">
        <div class="two-col">
          <label>Nombre de la pieza
            <input type="text" name="name" required placeholder="Ej. Motor completo" />
          </label>
          <label>Categoría
            <select name="category">
              <% PART_CATEGORIES.forEach(function(c) { %>
                <option value="<%= c %>"><%= PART_CATEGORY_LABELS[c] %></option>
              <% }); %>
            </select>
          </label>
        </div>
        <label>Estado de la pieza
          <select name="condition_grade">
            <% Object.values(PART_CONDITIONS).forEach(function(c) { %>
              <option value="<%= c %>"><%= PART_CONDITION_LABELS[c] %></option>
            <% }); %>
          </select>
        </label>
        <label>Precio sugerido (opcional)
          <input type="number" name="asking_price" step="0.01" min="0" />
        </label>
        <label>Notas (opcional)
          <input type="text" name="notes" />
        </label>
        <button type="submit" class="btn-secondary full-width">+ Agregar pieza</button>
      </form>
      <% } %>

      <% if (parts.length > 0) { %>
        <table class="admin-table" style="margin-top:16px;">
          <thead>
            <tr><th>Pieza</th><th>Categoría</th><th>Estado pieza</th><th>Precio</th><th>Estado</th><th></th></tr>
          </thead>
          <tbody>
            <% parts.forEach(function(p) { %>
              <tr>
                <td><%= p.name %></td>
                <td class="muted"><%= PART_CATEGORY_LABELS[p.category] || p.category %></td>
                <td class="muted"><%= p.condition_grade ? (PART_CONDITION_LABELS[p.condition_grade] || p.condition_grade) : '—' %></td>
                <td class="muted">$<%= p.asking_price ? Number(p.asking_price).toLocaleString('es-MX', {minimumFractionDigits:2}) : '—' %></td>
                <td><span class="status-badge status-<%= p.status %>"><%= PART_STATUS_LABELS[p.status] || p.status %></span></td>
                <td class="admin-actions">
                  <% if (canCompras && p.status !== 'vendida') { %>
                    <details style="display:inline-block;">
                      <summary class="link-strong" style="cursor:pointer; display:inline;">Editar</summary>
                      <form method="POST" action="/erp/parts/<%= p.id %>/update" class="card-form" style="margin-top:8px;">
                        <label>Nombre
                          <input type="text" name="name" value="<%= p.name %>" required />
                        </label>
                        <label>Categoría
                          <select name="category">
                            <% PART_CATEGORIES.forEach(function(c) { %>
                              <option value="<%= c %>" <%= p.category === c ? 'selected' : '' %>><%= PART_CATEGORY_LABELS[c] %></option>
                            <% }); %>
                          </select>
                        </label>
                        <label>Estado de la pieza
                          <select name="condition_grade">
                            <% Object.values(PART_CONDITIONS).forEach(function(c) { %>
                              <option value="<%= c %>" <%= p.condition_grade === c ? 'selected' : '' %>><%= PART_CONDITION_LABELS[c] %></option>
                            <% }); %>
                          </select>
                        </label>
                        <label>Precio sugerido
                          <input type="number" name="asking_price" step="0.01" min="0" value="<%= p.asking_price || '' %>" />
                        </label>
                        <label>Estado
                          <select name="status">
                            <option value="disponible" <%= p.status === 'disponible' ? 'selected' : '' %>>Disponible</option>
                            <option value="reservada" <%= p.status === 'reservada' ? 'selected' : '' %>>Reservada</option>
                            <option value="desechada" <%= p.status === 'desechada' ? 'selected' : '' %>>Desechada</option>
                          </select>
                        </label>
                        <label>Notas
                          <input type="text" name="notes" value="<%= p.notes || '' %>" />
                        </label>
                        <button type="submit" class="btn-primary full-width">Guardar</button>
                      </form>
                    </details>
                    <button type="button" class="link-strong btn-suggest-price" data-part-id="<%= p.id %>"
                            data-part-name="<%= p.name %>" data-part-condition="<%= p.condition_grade || 'bueno' %>"
                            style="background:none;border:none;cursor:pointer;font:inherit;">💡 Sugerir precio</button>
                    <form method="POST" action="/erp/parts/<%= p.id %>/delete" style="display:inline;"
                          onsubmit="return confirm('¿Borrar esta pieza?');">
                      <button type="submit" class="link-button" style="color:#B3261E;">Borrar</button>
                    </form>
                  <% } else { %>
                    <span class="muted small">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Ventas -->
    <% if (canVentas) { %>
    <div class="detail-box" style="margin-top:20px;">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h3 style="margin:0;">Registrar venta</h3>
        <% if (availableParts.length > 0) { %>
          <a href="/erp/cotizaciones/new?vehicle_id=<%= vehicle.id %>" class="btn-secondary">📝 Cotizar en vez de vender</a>
        <% } %>
      </div>
      <% if (availableParts.length === 0) { %>
        <p class="muted small">No hay piezas disponibles para vender (agrégalas arriba, o ya se vendieron todas).</p>
      <% } else { %>
        <form method="POST" action="/erp/vehicles/<%= vehicle.id %>/sales" class="card-form">
          <div class="two-col">
            <label>Comprador (opcional)
              <input type="text" name="buyer_name" />
            </label>
            <label>Fecha de venta
              <input type="date" name="sale_date" value="<%= new Date().toISOString().slice(0,10) %>" />
            </label>
          </div>
          <div>
            <p class="muted small" style="margin:0 0 8px;">Selecciona las piezas vendidas y confirma su precio:</p>
            <% availableParts.forEach(function(p) { %>
              <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border);">
                <input type="checkbox" name="part_ids[]" value="<%= p.id %>" id="sell-<%= p.id %>" style="width:auto;" />
                <label for="sell-<%= p.id %>" style="flex:1; font-weight:400; margin:0;"><%= p.name %> <span class="muted small">(<%= PART_CATEGORY_LABELS[p.category] %>)</span></label>
                <input type="number" name="price_<%= p.id %>" step="0.01" min="0" placeholder="Precio"
                       value="<%= p.asking_price || '' %>" style="width:120px;" />
              </div>
            <% }); %>
          </div>
          <label>Notas (opcional)
            <textarea name="notes" rows="2"></textarea>
          </label>
          <button type="submit" class="btn-primary full-width">Registrar venta</button>
        </form>
      <% } %>

      <% if (sales.length > 0) { %>
        <h4 style="margin-top:24px;">Historial de ventas</h4>
        <% sales.forEach(function(sale) { %>
          <div class="note-item">
            <p style="margin:0 0 4px; display:flex; justify-content:space-between; gap:8px;">
              <strong><%= sale.folio ? sale.folio + ' — ' : '' %><%= sale.buyer_name || 'Sin nombre de comprador' %></strong>
              <span>$<%= Number(sale.sale_total).toLocaleString('es-MX', {minimumFractionDigits:2}) %></span>
            </p>
            <p class="muted small" style="margin:0 0 4px;">
              <%= sale.sale_date %> —
              <%= sale.items.map(function(i){ return i.part_name + ' ($' + Number(i.price).toLocaleString('es-MX', {minimumFractionDigits:2}) + ')'; }).join(', ') %>
            </p>
            <% if (sale.sold_by_name) { %>
              <p class="muted small" style="margin:0 0 4px;">Vendido por: <strong><%= sale.sold_by_name %></strong></p>
            <% } %>
            <% if (sale.notes) { %><p class="muted small" style="margin:0 0 4px;"><%= sale.notes %></p><% } %>
            <form method="POST" action="/erp/sales/<%= sale.id %>/delete"
                  onsubmit="return confirm('¿Cancelar esta venta? Las piezas regresarán a Disponible.');">
              <button type="submit" class="link-button" style="color:#B3261E; font-size:0.8rem;">Cancelar venta</button>
            </form>
          </div>
        <% }); %>
      <% } %>
    </div>
    <% } %>

    <!-- Buscador rápido de compatibilidad -->
    <div class="detail-box" style="margin-top:20px;">
      <h3>🔎 Buscador rápido de compatibilidad</h3>
      <p class="muted small">Pregunta, por ejemplo: "Nissan Versa 2016 puerta derecha es compatible con qué modelos".</p>
      <div class="card-form">
        <label>Pregunta
          <input type="text" id="compat-question" placeholder="Ej. Nissan Versa 2016 puerta derecha compatible con..." />
        </label>
        <button type="button" id="compat-ask-btn" class="btn-secondary full-width">Preguntar</button>
      </div>
      <div id="compat-answer" class="muted small" style="margin-top:10px; white-space:pre-wrap;"></div>
    </div>
  </main>

  <script>
    (function() {
      var askBtn = document.getElementById('compat-ask-btn');
      if (askBtn) {
        askBtn.addEventListener('click', function() {
          var q = document.getElementById('compat-question').value.trim();
          var out = document.getElementById('compat-answer');
          if (!q) return;
          out.textContent = 'Buscando...';
          fetch('/erp/compatibilidad', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: q })
          }).then(function(r) { return r.json(); }).then(function(data) {
            out.textContent = data.ok ? data.answer : ('Error: ' + (data.error || 'No se pudo obtener respuesta.'));
          }).catch(function() {
            out.textContent = 'Error de conexión. Intenta de nuevo.';
          });
        });
      }

      document.querySelectorAll('.btn-suggest-price').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var partId = btn.getAttribute('data-part-id');
          var partName = btn.getAttribute('data-part-name');
          var condition = btn.getAttribute('data-part-condition');
          var original = btn.textContent;
          btn.textContent = 'Calculando...';
          fetch('/erp/parts/' + partId + '/sugerir-precio', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: partName, condition_grade: condition })
          }).then(function(r) { return r.json(); }).then(function(data) {
            btn.textContent = original;
            if (data.ok) {
              alert('Precio sugerido para "' + partName + '" (' + condition + '): $' + data.suggestedPrice);
            } else {
              alert('No se pudo sugerir un precio: ' + (data.error || 'error desconocido'));
            }
          }).catch(function() {
            btn.textContent = original;
            alert('Error de conexión. Intenta de nuevo.');
          });
        });
      });
    })();
  </script>
</body>
</html>
