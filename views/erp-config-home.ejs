<!DOCTYPE html>
<html lang="es">
<head>
  <title>Configuración — YonkSuite</title>
  <%- include('partials/head') %>
</head>
<body class="erp-shell">
  <%- include('partials/erp-header') %>

  <main class="page">
    <a href="/erp" class="back-link">&larr; Volver al inicio del ERP</a>
    <h1>Configuración</h1>
    <p class="subtitle">Ajustes generales de este YonkSuite.</p>

    <div class="campaign-grid">
      <a href="/erp/configuracion/empresa" class="campaign-card">
        <h3>🏢 Empresa</h3>
        <p class="muted small">Nombre, dirección, teléfono, logo, colores y datos fiscales para tus documentos.</p>
      </a>
      <a href="/erp/configuracion/transacciones" class="campaign-card">
        <h3>🔢 Configuración de transacciones</h3>
        <p class="muted small">Prefijo y número consecutivo para cada tipo de documento.</p>
      </a>
      <a href="/erp/configuracion/ubicaciones" class="campaign-card">
        <h3>📍 Ubicaciones</h3>
        <p class="muted small">Bodegas o sucursales donde se guarda el inventario.</p>
      </a>
      <a href="/erp/configuracion/monedas" class="campaign-card">
        <h3>💱 Monedas</h3>
        <p class="muted small">Catálogo de monedas en las que puedes transaccionar (tipo de cambio manual por transacción).</p>
      </a>
      <a href="/erp/configuracion/impuestos" class="campaign-card">
        <h3>🧾 Impuestos</h3>
        <p class="muted small">IVA, RESICO, Honorarios y demás impuestos que se aplican a tus artículos.</p>
      </a>
      <a href="/erp/configuracion/localizacion-mx" class="campaign-card">
        <h3>🇲🇽 Localización mexicana</h3>
        <p class="muted small">Régimen fiscal y proveedor de timbrado (PAC) — configuración base para facturar.</p>
      </a>
      <a href="/erp/configuracion/cuentas-contables" class="campaign-card">
        <h3>📊 Cuentas contables</h3>
        <p class="muted small">Catálogo de cuentas (activo, pasivo, capital, ingreso, costo, gasto) para tus pólizas de diario.</p>
      </a>
      <a href="/erp/configuracion/campos-personalizados" class="campaign-card">
        <h3>🧩 Personalizar campos</h3>
        <p class="muted small">Agrega tus propios campos a Artículos, Venta, Compra, Empleados y Pólizas.</p>
      </a>
      <a href="/erp/configuracion/aprobaciones" class="campaign-card">
        <h3>✅ Workflows de aprobación</h3>
        <p class="muted small">Exige aprobación antes de avanzar en ciertos tipos de documento de Ventas/Compras.</p>
      </a>
      <a href="/erp/configuracion/plantillas" class="campaign-card">
        <h3>📄 Personalización de plantillas</h3>
        <p class="muted small">Encabezado y pie de página que se agregan al PDF de comprobante de tus transacciones.</p>
      </a>
      <% if (erpActor && erpActor.moduleYonksuiteEnabled) { %>
        <a href="/erp/configuracion/categorias" class="campaign-card">
          <h3>🏷️ Categorías de piezas</h3>
          <p class="muted small">Personaliza las categorías que aparecen al dar de alta una pieza (módulo YonkSuite).</p>
        </a>
      <% } %>
    </div>
  </main>
</body>
</html>
