      { key: "conejo", emoji: "🐰", label: "Pascua / primavera", cat: "Temporada" },
      { key: "flor", emoji: "🌸", label: "Primavera / día de las madres", cat: "Temporada" },
      { key: "sol", emoji: "☀️", label: "Verano", cat: "Temporada" },
      { key: "copo", emoji: "❄️", label: "Invierno / frío", cat: "Temporada" },
      { key: "corazon-amor", emoji: "💘", label: "San Valentín", cat: "Temporada" },
      { key: "bandera-mx", emoji: "🇲🇽", label: "México / mes patrio", cat: "Temporada" },
      { key: "fuegos-artificiales", emoji: "🎆", label: "Año nuevo / gran evento", cat: "Temporada" },

      // --- Personas y celebración ---
      { key: "celebracion", emoji: "🎉", label: "Celebración", cat: "Personas y celebración" },
      { key: "confeti", emoji: "🎊", label: "Confeti / gran anuncio", cat: "Personas y celebración" },
      { key: "globo", emoji: "🎈", label: "Globo / cumpleaños", cat: "Personas y celebración" },
      { key: "familia", emoji: "👨‍👩‍👧‍👦", label: "Familia", cat: "Personas y celebración" },
      { key: "pareja", emoji: "🧑‍🤝‍🧑", label: "Clientes / comunidad", cat: "Personas y celebración" },
    ];

    function findSticker3D(key) {
      return STICKERS_3D.find(function (s) { return s.key === key; });
    }

    function addSticker3D(key) {
      const item = findSticker3D(key);
      if (!item) return;
      const sticker = new fabric.Text(item.emoji, {
        left: 160,
        top: 160,
        fontSize: 90,
        shadow: "rgba(0,0,0,0.35) 0px 6px 10px",
      });
      canvas.add(sticker);
      canvas.setActiveObject(sticker);
      canvas.renderAll();
    }

    // Arma el panel de "Recursos 3D" agrupado por categoría, con un buscador
    // que filtra por la etiqueta en español de cada sticker (ej. escribir
    // "dinero" muestra moneda/billetes/tarjeta aunque no digan "dinero"
    // literal en el nombre del emoji). Se genera por JS en vez de a mano en
    // el HTML porque son ~100 stickers — mantenerlos como datos es más
    // simple que escribir cada <button> uno por uno.
    function renderStickers3D(filterText) {
      const container = document.getElementById("stickers3d-container");
      const term = (filterText || "").trim().toLowerCase();
      const filtered = term
        ? STICKERS_3D.filter(function (s) { return s.label.toLowerCase().indexOf(term) !== -1; })
        : STICKERS_3D;

      if (!filtered.length) {
        container.innerHTML = '<p class="muted small">Sin resultados para "' + term + '".</p>';
        return;
      }

      const categories = [];
      const byCategory = {};
      filtered.forEach(function (item) {
        if (!byCategory[item.cat]) {
          byCategory[item.cat] = [];
          categories.push(item.cat);
        }
        byCategory[item.cat].push(item);
      });

      let html = "";
      categories.forEach(function (cat) {
        html += '<p class="muted small" style="margin:10px 0 4px; font-weight:700;">' + cat + "</p>";
        html += '<div class="shape-grid">';
        byCategory[cat].forEach(function (item) {
          html +=
            '<button type="button" class="tool-btn icon-btn" data-sticker3d="' + item.key +
            '" title="' + item.label + '" style="font-size:20px;">' + item.emoji + "</button>";
        });
        html += "</div>";
      });
      container.innerHTML = html;

      // Los botones se recrean cada vez que se filtra, así que hay que
      // volver a engancharles el evento de clic.
      container.querySelectorAll("[data-sticker3d]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          addSticker3D(btn.getAttribute("data-sticker3d"));
        });
      });
    }

    document.getElementById("stickers3d-search").addEventListener("input", function (e) {
      renderStickers3D(e.target.value);
    });

    function addSticker(key) {
      const factory = STICKERS[key];
      if (!factory) return;
      const sticker = factory();
      sticker.set({ left: 140, top: 140 });
      canvas.add(sticker);
      canvas.setActiveObject(sticker);
      canvas.renderAll();
    }

    function addSocialBadge(key) {
      const factory = SOCIAL_BADGES[key];
      if (!factory) return;
      const badge = factory();
      badge.set({ left: 160, top: 160 });
      canvas.add(badge);
      canvas.setActiveObject(badge);
      canvas.renderAll();
    }

    document.getElementById("btn-add-text").addEventListener("click", function () {
      const color = document.getElementById("text-color").value;
      const size = parseInt(document.getElementById("text-size").value, 10);
      addText("Escribe aquí", { fill: color, fontSize: size, top: 200 });
    });

    document.getElementById("btn-add-post-texts").addEventListener("click", function () {
      addAllPostTexts();
    });

    // Herramienta de corrección: arma el flujo completo "clic para tomar el
    // color de fondo → aparece un rectángulo de ese color listo para mover y
    // agrandar" — así el negocio puede tapar una palabra mal escrita sin
    // tener que adivinar qué color de fondo usar.
    let colorPatchMode = false;
    const statusEl = document.getElementById("save-status");

    document.getElementById("btn-color-patch").addEventListener("click", function () {
      colorPatchMode = true;
      canvas.discardActiveObject();
      canvas.renderAll();
      canvas.defaultCursor = "crosshair";
      canvas.hoverCursor = "crosshair";
      if (statusEl) statusEl.textContent = "Haz clic sobre la foto, donde quieras tapar algo, para tomar ese color…";
    });

    canvas.on("mouse:down", function (opt) {
      if (!colorPatchMode) return;
      const pointer = canvas.getPointer(opt.e);
      let hex = "#FFFFFF";
      try {
        const ctx = canvas.lowerCanvasEl.getContext("2d");
        const scaleX = canvas.lowerCanvasEl.width / canvas.getWidth();
        const scaleY = canvas.lowerCanvasEl.height / canvas.getHeight();
        const px = Math.max(0, Math.round(pointer.x * scaleX));
        const py = Math.max(0, Math.round(pointer.y * scaleY));
        const pixel = ctx.getImageData(px, py, 1, 1).data;
        hex = "#" + [pixel[0], pixel[1], pixel[2]].map(function (v) {
          return v.toString(16).padStart(2, "0");
        }).join("");
      } catch (err) {
        // si por lo que sea no se puede leer el pixel, seguimos con blanco
      }

      const patch = new fabric.Rect({
        left: pointer.x - 60,
        top: pointer.y - 18,
        width: 120,
        height: 36,
        fill: hex,
      });
      canvas.add(patch);
      canvas.setActiveObject(patch);
      canvas.renderAll();

      colorPatchMode = false;
      canvas.defaultCursor = "default";
      canvas.hoverCursor = "move";
      if (statusEl) {
        statusEl.textContent = "Listo — ajusta el tamaño/posición del parche y agrega texto o una forma encima si hace falta.";
      }
    });

    document.querySelectorAll("[data-shape]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        addShape(btn.getAttribute("data-shape"));
      });
    });

    document.querySelectorAll("[data-icon]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        addIcon(btn.getAttribute("data-icon"));
      });
    });

    document.querySelectorAll("[data-social]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        addSocialBadge(btn.getAttribute("data-social"));
      });
    });

    document.querySelectorAll("[data-sticker]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        addSticker(btn.getAttribute("data-sticker"));
      });
    });

    // El panel de Recursos 3D se genera dinámicamente (ver renderStickers3D)
    // porque son ~100 stickers con buscador — no hay botones fijos en el
    // HTML que enganchar aquí.

    document.getElementById("text-color").addEventListener("input", function (e) {
      const obj = canvas.getActiveObject();
      if (obj && obj.type === "textbox") {
        obj.set("fill", e.target.value);
        canvas.renderAll();
      }
    });

    document.getElementById("text-size").addEventListener("input", function (e) {
      const obj = canvas.getActiveObject();
      if (obj && obj.type === "textbox") {
        obj.set("fontSize", parseInt(e.target.value, 10));
        canvas.renderAll();
      }
    });

    document.getElementById("text-font").addEventListener("change", function (e) {
      const obj = canvas.getActiveObject();
      if (obj && obj.type === "textbox") {
        obj.set("fontFamily", e.target.value);
        canvas.renderAll();
      }
    });

    // Negrita/cursiva/alineación/espaciado — más control de estilo de texto,
    // al estilo de la barra de herramientas de texto de Canva. Negrita y
    // cursiva son "toggle" (se activan/desactivan sobre el texto seleccionado).
    document.getElementById("btn-text-bold").addEventListener("click", function () {
      const obj = canvas.getActiveObject();
      if (!obj || obj.type !== "textbox") return;
      const isBold = obj.fontWeight === "700" || obj.fontWeight === "800" || obj.fontWeight === 700 || obj.fontWeight === 800;
      obj.set("fontWeight", isBold ? "400" : "800");
      canvas.renderAll();
    });

    document.getElementById("btn-text-italic").addEventListener("click", function () {
      const obj = canvas.getActiveObject();
      if (!obj || obj.type !== "textbox") return;
      obj.set("fontStyle", obj.fontStyle === "italic" ? "normal" : "italic");
      canvas.renderAll();
    });

    function setTextAlign(align) {
      const obj = canvas.getActiveObject();
      if (!obj || obj.type !== "textbox") return;
      obj.set("textAlign", align);
      canvas.renderAll();
    }
    document.getElementById("btn-text-align-left").addEventListener("click", function () { setTextAlign("left"); });
    document.getElementById("btn-text-align-center").addEventListener("click", function () { setTextAlign("center"); });
    document.getElementById("btn-text-align-right").addEventListener("click", function () { setTextAlign("right"); });

    document.getElementById("text-spacing").addEventListener("input", function (e) {
      const obj = canvas.getActiveObject();
      if (obj && obj.type === "textbox") {
        obj.set("charSpacing", parseInt(e.target.value, 10));
        canvas.renderAll();
      }
    });

    // Aplica un color a CUALQUIER objeto o selección — círculos, rectángulos,
    // texto, íconos, líneas (que se colorean por su trazo, no su relleno),
    // e insignias/grupos (solo la pieza de fondo, para no perder el ícono
    // blanco de encima). Si hay varios objetos seleccionados a la vez (con
    // Shift+clic), se colorean todos juntos.
    //
    // Nota: la marca isBadgeBackground no sobrevive a duplicar (clone) ni a
    // guardar/recuperar el lienzo (toJSON solo serializa propiedades
    // estándar) — por eso, si ningún hijo la tiene, se usa el primer objeto
    // del grupo como respaldo. En todas las insignias de este editor, el
    // fondo siempre se agrega primero, así que ese orden es un respaldo
    // confiable incluso después de duplicar o recargar.
    function findBadgeBackground(kids) {
      return kids.find(function (child) { return child.isBadgeBackground; }) || kids[0];
    }

    function applyColorToObject(obj, color) {
      if (!obj) return;
      if (obj.type === "line") {
        obj.set("stroke", color);
        return;
      }
      if (obj.type === "group" || obj.type === "activeSelection") {
        const kids = obj._objects || [];
        if (!kids.length) return;
        const bg = findBadgeBackground(kids);
        if (bg) applyColorToObject(bg, color);
        return;
      }
      obj.set("fill", color);
    }

    document.getElementById("shape-color").addEventListener("input", function (e) {
      const obj = canvas.getActiveObject();
      if (obj && obj.type !== "textbox" && obj.type !== "image") {
        applyColorToObject(obj, e.target.value);
        canvas.requestRenderAll();
      }
    });

    // Al seleccionar un objeto existente, refleja sus valores reales en los
    // controles (color, tamaño, fuente) — así no parece que el control "no
    // hace nada" cuando en realidad estaba desincronizado con la selección.
    function syncControlsToSelection() {
      const obj = canvas.getActiveObject();
      if (!obj) return;
      if (obj.type === "textbox") {
        if (typeof obj.fill === "string" && obj.fill.startsWith("#")) {
          document.getElementById("text-color").value = obj.fill;
        }
        document.getElementById("text-size").value = Math.round(obj.fontSize || 36);
        document.getElementById("text-spacing").value = obj.charSpacing || 0;
        const fontSelect = document.getElementById("text-font");
        if (obj.fontFamily && Array.from(fontSelect.options).some((o) => o.value === obj.fontFamily)) {
          fontSelect.value = obj.fontFamily;
        }
        return;
      }
      if (obj.type === "image") return;

      const shapeColorInput = document.getElementById("shape-color");
      if (obj.type === "line") {
        if (typeof obj.stroke === "string" && obj.stroke.startsWith("#")) {
          shapeColorInput.value = obj.stroke;
        }
        return;
      }
      if (obj.type === "group" || obj.type === "activeSelection") {
        const kids = obj._objects || [];
        const bg = kids.find(function (child) { return child.isBadgeBackground; }) || kids[0];
        if (bg && typeof bg.fill === "string" && bg.fill.startsWith("#")) {
          shapeColorInput.value = bg.fill;
        }
        return;
      }
      if (typeof obj.fill === "string" && obj.fill.startsWith("#")) {
        shapeColorInput.value = obj.fill;
      }
    }
    canvas.on("selection:created", syncControlsToSelection);
    canvas.on("selection:updated", syncControlsToSelection);
    canvas.on("selection:created", updateRemoveBgAvailability);
    canvas.on("selection:updated", updateRemoveBgAvailability);
    canvas.on("selection:cleared", updateRemoveBgAvailability);

    // Por defecto el editor arranca en "modo simple": el diseño ya sale
    // completo (armado por buildDefaultLayout), así que solo se muestra el
    // control de logo. El resto de las herramientas (texto, formas, íconos,
    // parche de color, capas) quedan un clic de distancia detrás de este
    // botón, para quien sí quiera personalizar más a fondo.
    document.getElementById("btn-toggle-advanced").addEventListener("click", function () {
      const panel = document.getElementById("advanced-tools");
      const showing = panel.style.display !== "none";
      panel.style.display = showing ? "none" : "block";
      this.textContent = showing ? "🔧 Mostrar herramientas avanzadas" : "🔧 Ocultar herramientas avanzadas";
    });

    // Con las herramientas avanzadas ocultas por defecto, el botón "Eliminar
    // seleccionado" no siempre está a la vista — Supr/Backspace deja borrar
    // cualquier objeto seleccionado sin tener que activar el modo avanzado.
    // Si el objeto es un texto que se está editando, se ignora (para no
    // borrar el objeto completo mientras el negocio solo quiere borrar una
    // letra del texto).
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Delete" && e.key !== "Backspace") return;
      const obj = canvas.getActiveObject();
      if (!obj || obj.isEditing) return;
      e.preventDefault();
      canvas.remove(obj);
    });

    document.getElementById("btn-add-logo").addEventListener("click", addLogo);

    // Duplica el objeto seleccionado (o varios, si seleccionaste más de uno
    // con Shift+clic) — útil para armar una segunda insignia igual a la
    // primera sin tener que rehacerla desde cero.
    document.getElementById("btn-duplicate").addEventListener("click", function () {
      const activeObj = canvas.getActiveObject();
      if (!activeObj) return;
      activeObj.clone(function (cloned) {
        canvas.discardActiveObject();
        if (cloned.type === "activeSelection") {
          cloned.canvas = canvas;
          cloned.forEachObject(function (obj) {
            obj.set({ left: (obj.left || 0) + 24, top: (obj.top || 0) + 24 });
            canvas.add(obj);
          });
          cloned.setCoords();
        } else {
          cloned.set({ left: (cloned.left || 0) + 24, top: (cloned.top || 0) + 24 });
          canvas.add(cloned);
        }
        canvas.setActiveObject(cloned);
        canvas.renderAll();
      });
    });

    document.getElementById("btn-front").addEventListener("click", function () {
      const obj = canvas.getActiveObject();
      if (obj) canvas.bringToFront(obj);
    });
    document.getElementById("btn-back").addEventListener("click", function () {
      const obj = canvas.getActiveObject();
      if (obj) canvas.sendToBack(obj);
    });
    document.getElementById("btn-delete").addEventListener("click", function () {
      const obj = canvas.getActiveObject();
      if (obj) canvas.remove(obj);
    });

    document.getElementById("btn-reset").addEventListener("click", function () {
      if (!confirm("¿Borrar todo lo que agregaste/moviste y volver a armar el punto de partida original?")) return;
      canvas.getObjects().slice().forEach(function (o) { canvas.remove(o); });
      canvas.discardActiveObject();
      canvas.renderAll();
      buildDefaultLayout();
    });

    // Revisa si queda algún texto de ejemplo sin editar (marcado con ✏️,
    // como la insignia de oferta cuando no se detectó un descuento en el
    // brief) antes de guardar — así no se publica sin querer una imagen con
    // "✏️ Tu oferta aquí" tal cual.
    function findUneditedPlaceholder() {
      return canvas.getObjects().find(function (obj) {
        return (
          obj.type === "textbox" &&
          typeof obj.text === "string" &&
          obj.text.indexOf(PLACEHOLDER_MARK) === 0
        );
      });
    }

    document.getElementById("btn-save").addEventListener("click", function () {
      const placeholder = findUneditedPlaceholder();
      if (placeholder) {
        canvas.setActiveObject(placeholder);
        canvas.renderAll();
        const proceed = confirm(
          'Dejaste un texto de ejemplo sin personalizar: "' + placeholder.text.replace("✏️ ", "") +
            '". Lo seleccionamos para que lo edites — ¿o prefieres guardar así de todas formas?'
        );
        if (!proceed) return;
      }

      canvas.discardActiveObject();
      canvas.renderAll();
      const dataUrl = canvas.toDataURL({
        format: "png",
        multiplier: EXPORT_SIZE / DISPLAY_SIZE,
      });

      // Guardamos también el estado editable (textos/formas/íconos/logo) sin
      // el fondo — así, si el negocio vuelve a entrar al editor, se le
      // devuelve exactamente lo que dejó, sin gastar otra generación de IA.
      const stateJson = canvas.toJSON();
      delete stateJson.backgroundImage;
      const canvasStateStr = JSON.stringify(stateJson);

      const statusEl = document.getElementById("save-status");
      statusEl.textContent = "Guardando...";

      fetch(saveUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ image: dataUrl, canvasState: canvasStateStr }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.ok) {
            statusEl.textContent = "¡Guardado!";
            window.location.href = data.redirect;
          } else {
            statusEl.textContent = data.error || "Ocurrió un error al guardar.";
          }
        })
        .catch(function () {
          statusEl.textContent = "Ocurrió un error al guardar. Intenta de nuevo.";
        });
    });

    renderStickers3D("");

    loadFonts().then(function () {
      loadBackground();
      if (initialCanvasState) {
        restoreCanvasState(initialCanvasState);
      } else {
        buildDefaultLayout();
      }
    });
  </script>
</body>
</html>
