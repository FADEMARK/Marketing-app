      canvas.add(waIcon);

      if (editorData.cta) {
        addText(editorData.cta, {
          left: 90,
          top: 464,
          width: DISPLAY_SIZE - 110,
          fontSize: 22,
          fontFamily: "Montserrat, sans-serif",
          fontWeight: "800",
          fill: "#FFFFFF",
          textAlign: "left",
          shadow: null,
        });
      }

      // Barra de contacto/dirección — su PROPIO recuadro, separado del de
      // arriba, en el color secundario de marca para diferenciarlo. Es un
      // rectángulo independiente: se puede mover, recolorear o borrar sin
      // afectar la barra de CTA.
      if (editorData.contactLine) {
        const contactBarColor = editorData.brandColorSecondary || "#0B0B0B";
        const contactBar = new fabric.Rect({ left: 0, top: 507, width: DISPLAY_SIZE, height: 33, fill: contactBarColor });
        canvas.add(contactBar);

        const locationIcon = new fabric.Path(ICONS.location.d, {
          left: 24,
          top: 514,
          fill: "#FFFFFF",
          scaleX: 0.9,
          scaleY: 0.9,
        });
        canvas.add(locationIcon);

        addText(editorData.contactLine, {
          left: 56,
          top: 513,
          width: DISPLAY_SIZE - 76,
          fontSize: 13,
          fontFamily: "Lato, sans-serif",
          fontWeight: "400",
          fill: "#FFFFFF",
          textAlign: "left",
          shadow: null,
        });
      }

      canvas.discardActiveObject();
      canvas.renderAll();
    }

