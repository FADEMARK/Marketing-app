<!DOCTYPE html>
<html lang="es">
<head>
  <title>Editor — <%= campaign.product_service %> — MarketingHub</title>
  <%- include('partials/head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Montserrat:ital,wght@0,500;0,700;0,800;1,700&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,600&family=Oswald:wght@500;700&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Raleway:ital,wght@0,400;0,700;1,700&family=Lato:ital,wght@0,400;0,700;1,400&family=Pacifico&family=Dancing+Script:wght@700&family=Archivo+Black&family=Passion+One:wght@700;900&family=Baloo+2:wght@600;700&family=Fredoka:wght@500;600&family=Cormorant+Garamond:wght@600;700&family=Space+Grotesk:wght@500;700&family=Merriweather:wght@700;900&family=Bungee&family=Space+Mono:wght@700&display=swap"
    rel="stylesheet"
  />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js"></script>
</head>
<body>
  <%- include('partials/nav') %>

  <main class="page">
    <a href="/campaigns/<%= campaign.id %>" class="back-link">&larr; Volver a la campaña</a>

    <div class="page-header">
      <h1>Personaliza tu imagen</h1>
    </div>
    <% if (typeof initialCanvasState !== 'undefined' && initialCanvasState) { %>
      <p class="muted">
        Recuperamos tu edición anterior tal como la dejaste — sigue ajustándola libremente, no se
        gasta otra generación de IA por volver a entrar.
      </p>
    <% } else { %>
      <p class="muted">
        La IA ya arma automáticamente el diseño completo sobre la fotografía de fondo — título, la
        oferta, la barra de WhatsApp y tu dirección. Normalmente solo necesitas revisar/mover el logo
        y darle "Guardar y continuar". Si quieres personalizar algo más a fondo (mover el título,
        cambiar colores, agregar texto o formas), activa "Mostrar herramientas avanzadas" — cada pieza
        del diseño es un objeto real que se puede mover, recolorear, editar o borrar libremente (haz
        clic para seleccionarlo y usa la tecla Supr/Backspace para borrarlo).
      </p>
    <% } %>

    <div class="editor-layout">
      <aside class="editor-toolbar">
        <div class="tool-group" style="background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px;">
          <button type="button" class="tool-btn" id="btn-toggle-advanced">🔧 Mostrar herramientas avanzadas</button>
          <p class="muted small" style="margin-top:6px;">
            Ya dejamos todo armado automáticamente (título, oferta, WhatsApp, contacto). Normalmente
            solo necesitas confirmar o mover el logo y guardar. Activa esto si quieres personalizar
            texto, formas, íconos o colores a mano.
          </p>
        </div>

        <div class="tool-group">
          <h4>Logo</h4>
          <% if (editorData.logoDataUri) { %>
            <button type="button" class="tool-btn" id="btn-add-logo">+ Agregar logo</button>
          <% } else { %>
            <p class="muted small">No tienes un logo cargado. Súbelo desde "Mi negocio".</p>
          <% } %>
        </div>

        <div id="advanced-tools" style="display:none;">
        <div class="tool-group" style="background: var(--bg); border: 1px solid var(--primary); border-radius: 8px; padding: 10px;">
          <h4 style="color: var(--primary);">Parche de color</h4>
          <button type="button" class="tool-btn" id="btn-color-patch">🩹 Tapar una zona</button>
          <p class="muted small" style="margin-top:6px;">
            1) Clic aquí. 2) Clic sobre la foto, donde quieras tapar algo, para copiar ese color. 3)
            Mueve/ajusta el parche hasta cubrir esa zona. 4) Agrega texto o una forma nueva encima si
            hace falta.
          </p>
        </div>

        <div class="tool-group">
          <h4>Texto</h4>
          <button type="button" class="tool-btn" id="btn-add-text">+ Agregar texto</button>
          <button type="button" class="tool-btn" id="btn-add-post-texts">+ Agregar textos del post (título, mensaje, CTA, contacto)</button>
          <label class="muted small" style="display:block; margin-top:8px;">Tipo de letra</label>
          <select id="text-font">
            <optgroup label="Impacto / títulos">
              <option value="Anton, sans-serif">Anton</option>
              <option value="'Bebas Neue', sans-serif">Bebas Neue</option>
              <option value="Oswald, sans-serif">Oswald</option>
              <option value="'Archivo Black', sans-serif">Archivo Black</option>
              <option value="'Passion One', sans-serif">Passion One</option>
              <option value="Bungee, sans-serif">Bungee</option>
            </optgroup>
            <optgroup label="Texto / cuerpo">
              <option value="Montserrat, sans-serif" selected>Montserrat</option>
              <option value="Poppins, sans-serif">Poppins</option>
              <option value="Raleway, sans-serif">Raleway</option>
              <option value="Lato, sans-serif">Lato</option>
              <option value="'Space Grotesk', sans-serif">Space Grotesk</option>
            </optgroup>
            <optgroup label="Elegante / serif">
              <option value="'Playfair Display', serif">Playfair Display</option>
              <option value="'Cormorant Garamond', serif">Cormorant Garamond</option>
              <option value="Merriweather, serif">Merriweather</option>
            </optgroup>
            <optgroup label="Manuscrita">
              <option value="Pacifico, cursive">Pacifico</option>
              <option value="'Dancing Script', cursive">Dancing Script</option>
            </optgroup>
            <optgroup label="Amigable / redondeada">
              <option value="'Baloo 2', cursive">Baloo 2</option>
              <option value="Fredoka, sans-serif">Fredoka</option>
            </optgroup>
            <optgroup label="Especial">
              <option value="'Space Mono', monospace">Space Mono (ticket)</option>
            </optgroup>
          </select>
          <label class="muted small" style="display:block; margin-top:8px;">Estilo</label>
          <div class="shape-grid" style="grid-template-columns: repeat(5, 1fr);">
            <button type="button" class="tool-btn" id="btn-text-bold" title="Negrita" style="font-weight:800;">N</button>
            <button type="button" class="tool-btn" id="btn-text-italic" title="Cursiva" style="font-style:italic;">K</button>
            <button type="button" class="tool-btn" id="btn-text-align-left" title="Alinear a la izquierda">⟸</button>
            <button type="button" class="tool-btn" id="btn-text-align-center" title="Centrar">≡</button>
            <button type="button" class="tool-btn" id="btn-text-align-right" title="Alinear a la derecha">⟹</button>
          </div>
          <label class="muted small" style="display:block; margin-top:8px;">Color de texto</label>
          <input type="color" id="text-color" value="#FFFFFF" />
          <label class="muted small" style="display:block; margin-top:8px;">Tamaño</label>
          <input type="range" id="text-size" min="14" max="120" value="36" style="width:100%;" />
          <label class="muted small" style="display:block; margin-top:8px;">Espaciado entre letras</label>
          <input type="range" id="text-spacing" min="-50" max="400" value="0" style="width:100%;" />
        </div>

        <div class="tool-group">
          <h4>Autoformas</h4>
          <div class="shape-grid">
            <button type="button" class="tool-btn" data-shape="rect" title="Rectángulo">▭</button>
            <button type="button" class="tool-btn" data-shape="rrect" title="Rectángulo redondeado">▢</button>
            <button type="button" class="tool-btn" data-shape="circle" title="Círculo / óvalo">◯</button>
            <button type="button" class="tool-btn" data-shape="line" title="Línea">╱</button>
            <button type="button" class="tool-btn" data-shape="arrow" title="Flecha">➜</button>
            <button type="button" class="tool-btn" data-shape="star" title="Estrella / insignia">★</button>
          </div>
          <label class="muted small" style="display:block; margin-top:10px;">Color de forma</label>
          <input type="color" id="shape-color" value="<%= editorData.brandColorPrimary %>" />
          <p class="muted small" style="margin-top:6px;">
            Funciona con lo que tengas seleccionado: círculos, rectángulos, líneas, íconos e incluso
            insignias de redes sociales (recolorea el fondo de la insignia).
          </p>
        </div>

        <div class="tool-group">
          <h4>Imágenes</h4>
          <button type="button" class="tool-btn" id="btn-upload-image">📁 Subir imagen</button>
          <input type="file" id="image-file-input" accept="image/*" style="display:none;" />
          <p class="muted small" style="margin-top:6px;">
            También puedes copiar una imagen (de tu computadora, o de Google/Word/etc.) y pegarla
            directamente aquí con Ctrl+V (o Cmd+V en Mac).
          </p>
          <button type="button" class="tool-btn" id="btn-remove-bg" style="margin-top:8px;" disabled>
            ✂️ Quitar fondo de la imagen seleccionada
          </button>
          <p class="muted small" id="remove-bg-status" style="margin-top:6px;">
            Selecciona una imagen en el lienzo para poder quitarle el fondo (deja solo el objeto/
            persona, sin el resto de la foto). Tarda unos segundos — se procesa aquí mismo, sin
            mandar tu imagen a ningún servicio externo.
          </p>
        </div>

        <div class="tool-group">
          <h4>Filtros</h4>
          <button type="button" class="tool-btn" id="btn-filter-target-bg">🖼️ Editar la foto de fondo</button>
          <p class="muted small" id="filter-target-status" style="margin-top:6px;">
            Selecciona una imagen en el lienzo, o usa el botón de arriba para editar la foto de
            fondo — los filtros de abajo se aplican a lo que esté activo.
          </p>
          <label class="muted small" style="display:block; margin-top:10px;">Preajustes</label>
          <div class="shape-grid" style="grid-template-columns: repeat(3, 1fr);">
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="ninguno">Ninguno</button>
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="vivido">Vívido</button>
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="bn">Blanco y negro</button>
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="sepia">Sepia</button>
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="calido">Cálido</button>
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="frio">Frío</button>
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="contraste">Alto contraste</button>
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="nitida">Nítida</button>
            <button type="button" class="tool-btn filter-preset-btn" data-filter-preset="suave">Suave</button>
          </div>
          <label class="muted small" style="display:block; margin-top:10px;">Brillo</label>
          <input type="range" id="filter-brightness" min="-100" max="100" value="0" style="width:100%;" />
          <label class="muted small" style="display:block; margin-top:8px;">Contraste</label>
          <input type="range" id="filter-contrast" min="-100" max="100" value="0" style="width:100%;" />
          <label class="muted small" style="display:block; margin-top:8px;">Saturación</label>
          <input type="range" id="filter-saturation" min="-100" max="100" value="0" style="width:100%;" />
          <p class="muted small" style="margin-top:6px;">
            Los preajustes son un punto de partida rápido; después puedes afinar con los controles
            de brillo/contraste/saturación (mover cualquiera de estos tres reemplaza el preajuste).
          </p>
        </div>

        <div class="tool-group">
          <h4>Íconos de contacto</h4>
          <div class="shape-grid">
            <button type="button" class="tool-btn icon-btn" data-icon="location" title="Ubicación / Dirección" style="color:#EA4335;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="phone" title="Teléfono" style="color:#1877F2;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="whatsapp" title="WhatsApp" style="color:#25D366;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="mail" title="Correo" style="color:#1877F2;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </button>
          </div>
          <p class="muted small" style="margin-top:8px;">
            Se agregan con el color típico de cada uno — puedes recolorearlos abajo si prefieres que combinen con tu marca.
          </p>
        </div>

        <div class="tool-group">
          <h4>Íconos de marketing</h4>
          <div class="shape-grid">
            <button type="button" class="tool-btn icon-btn" data-icon="tag" title="Etiqueta de precio / oferta" style="color:#F59E0B;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.41l9 9c.36.36.86.59 1.41.59.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="clock" title="Tiempo limitado" style="color:#111111;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="bolt" title="Oferta relámpago" style="color:#F59E0B;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="check" title="Garantía / beneficio" style="color:#22C55E;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="cart" title="Carrito de compras" style="color:#1877F2;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="gift" title="Regalo / promoción" style="color:#D62976;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="heart" title="Favorito / me gusta" style="color:#E11D48;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </button>
            <button type="button" class="tool-btn icon-btn" data-icon="star" title="Estrella / calificación" style="color:#F59E0B;">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            </button>
          </div>
        </div>

        <div class="tool-group">
          <h4>Stickers</h4>
          <div class="shape-grid">
            <button type="button" class="tool-btn icon-btn" data-sticker="oferta" title="OFERTA">
              <span class="social-swatch" style="background:#E11D48; border-radius:6px; font-size:8px; font-weight:800;">OF</span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-sticker="nuevo" title="NUEVO">
              <span class="social-swatch" style="background:#1877F2; border-radius:6px; font-size:8px; font-weight:800;">NU</span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-sticker="gratis" title="¡GRATIS!">
              <span class="social-swatch" style="background:#22C55E; border-radius:6px; font-size:8px; font-weight:800;">GR</span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-sticker="descuento" title="Cintillo de descuento">
              <span class="social-swatch" style="background:#F59E0B; border-radius:6px; font-size:8px; font-weight:800;">%</span>
            </button>
          </div>
          <p class="muted small" style="margin-top:8px;">
            Insignias tipo Canva, listas para pegar — puedes editar el texto y recolorear el fondo
            igual que con cualquier otra insignia.
          </p>
        </div>

        <div class="tool-group">
          <h4>Recursos 3D</h4>
          <input
            type="text"
            id="stickers3d-search"
            placeholder="Buscar (ej. fuego, dinero, reloj, navidad...)"
            style="width:100%; box-sizing:border-box; margin-bottom:10px; padding:6px 8px; border-radius:6px; border:1px solid var(--border);"
          />
          <div id="stickers3d-container"></div>
          <p class="muted small" style="margin-top:8px;">
            Stickers grandes y a color, listos para poner sobre tu foto — se pueden mover, rotar,
            agrandar o duplicar como cualquier otro objeto.
          </p>
        </div>

        <div class="tool-group">
          <h4>Redes sociales</h4>
          <div class="shape-grid">
            <button type="button" class="tool-btn icon-btn" data-social="facebook" title="Facebook">
              <span class="social-swatch" style="background:#1877F2; font-family:Georgia, serif; font-weight:700;">f</span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-social="instagram" title="Instagram">
              <span class="social-swatch" style="background:linear-gradient(45deg,#FEDA75,#FA7E1E,#D62976,#962FBF); border-radius:6px;"></span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-social="tiktok" title="TikTok">
              <span class="social-swatch" style="background:#010101; border-radius:6px;">♪</span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-social="youtube" title="YouTube">
              <span class="social-swatch" style="background:#FF0000; border-radius:6px;">
                <span style="display:inline-block; width:0; height:0; border-top:5px solid transparent; border-bottom:5px solid transparent; border-left:8px solid #fff; margin-left:2px;"></span>
              </span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-social="x" title="X (Twitter)">
              <span class="social-swatch" style="background:#000; border-radius:6px; font-weight:800;">X</span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-social="linkedin" title="LinkedIn">
              <span class="social-swatch" style="background:#0A66C2; border-radius:6px; font-weight:800; font-size:10px;">in</span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-social="whatsapp" title="WhatsApp">
              <span class="social-swatch" style="background:#25D366;">💬</span>
            </button>
            <button type="button" class="tool-btn icon-btn" data-social="messenger" title="Messenger">
              <span class="social-swatch" style="background:linear-gradient(45deg,#00B2FF,#006AFF,#B620E0);">💬</span>
            </button>
          </div>
          <p class="muted small" style="margin-top:8px;">
            Insignias listas para poner junto a tu usuario/handle de cada red. Selecciónalas y usa
            "Color de forma" arriba para adaptar el fondo a tu marca.
          </p>
        </div>

        <div class="tool-group">
          <h4>Capas</h4>
          <button type="button" class="tool-btn" id="btn-duplicate">⧉ Duplicar seleccionado</button>
          <button type="button" class="tool-btn" id="btn-front">Traer al frente</button>
          <button type="button" class="tool-btn" id="btn-back">Enviar atrás</button>
          <button type="button" class="tool-btn" id="btn-delete">Eliminar seleccionado</button>
          <p class="muted small" style="margin-top:6px;">
            Tip: con Shift, haz clic en varias piezas (ej. un círculo + su texto) para moverlas o
            duplicarlas juntas.
          </p>
        </div>
        </div>
      </aside>

      <div>
        <div class="editor-canvas-wrap">
          <canvas id="editor-canvas" width="540" height="540"></canvas>
        </div>
        <div class="editor-actions">
          <button type="button" class="btn-secondary" id="btn-reset">Empezar de nuevo</button>
          <button type="button" class="btn-primary" id="btn-save">Guardar y continuar</button>
        </div>
        <p class="muted small" id="save-status" style="margin-top:8px;"></p>
      </div>
    </div>
  </main>

  <script>
    const backgroundImageData = <%- JSON.stringify(backgroundImageData) %>;
    const editorData = <%- JSON.stringify(editorData) %>;
    const initialCanvasState = <%- JSON.stringify(typeof initialCanvasState !== 'undefined' ? initialCanvasState : null) %>;
    const saveUrl = "/campaigns/<%= campaign.id %>/save-edited-image";

    const DISPLAY_SIZE = 540;
    const EXPORT_SIZE = 1080;

    // Prefijo que marca un texto de ejemplo sin personalizar (ej. la
    // insignia de oferta cuando no se detectó un descuento concreto en el
    // brief). btn-save revisa esto antes de guardar/exportar, para no dejar
    // pasar un texto de relleno como "✏️ Tu oferta aquí" a la imagen final.
    const PLACEHOLDER_MARK = "✏️";

    const canvas = new fabric.Canvas("editor-canvas", {
      width: DISPLAY_SIZE,
      height: DISPLAY_SIZE,
      preserveObjectStacking: true,
    });

    // Tipografías de marketing (Google Fonts) que se pueden elegir para
    // cualquier texto. Las precargamos antes de dibujar nada en el lienzo
    // para que el primer render ya use la fuente correcta (si no, el canvas
    // a veces dibuja con la fuente de respaldo del sistema).
    const FONT_LOAD_SPECS = [
      "700 40px Montserrat",
      "600 40px Poppins",
      "400 40px 'Bebas Neue'",
      "400 40px Anton",
      "600 40px Oswald",
      "700 40px 'Playfair Display'",
      "700 40px Raleway",
      "700 40px Lato",
      "400 40px Pacifico",
      "700 40px 'Dancing Script'",
      "400 40px 'Archivo Black'",
      "700 40px 'Passion One'",
      "700 40px 'Baloo 2'",
      "600 40px Fredoka",
      "700 40px 'Cormorant Garamond'",
      "700 40px 'Space Grotesk'",
      "700 40px Merriweather",
      "400 40px Bungee",
      "700 40px 'Space Mono'",
    ];

    function loadFonts() {
      if (!document.fonts || !document.fonts.load) return Promise.resolve();
      return Promise.all(
        FONT_LOAD_SPECS.map(function (spec) {
          return document.fonts.load(spec).catch(function () { return null; });
        })
      );
    }

    function loadBackground() {
      fabric.Image.fromURL(backgroundImageData, function (img) {
        img.scaleToWidth(DISPLAY_SIZE);
        img.scaleToHeight(DISPLAY_SIZE);
        canvas.setBackgroundImage(img, canvas.renderAll.bind(canvas), {
          originX: "left",
          originY: "top",
        });
      });
    }

    function addText(text, opts) {
      opts = opts || {};
      const defaultFont = document.getElementById("text-font")
        ? document.getElementById("text-font").value
        : "Montserrat, sans-serif";
      const t = new fabric.Textbox(text, Object.assign({
        left: 40,
        top: 40,
        width: DISPLAY_SIZE - 80,
        fontSize: 36,
        fill: "#FFFFFF",
        fontFamily: defaultFont,
        fontWeight: "600",
        textAlign: "center",
        shadow: "rgba(0,0,0,0.45) 0px 2px 6px",
      }, opts));
      canvas.add(t);
      canvas.setActiveObject(t);
      return t;
    }

    // La IA ya escribe el título/mensaje/CTA/contacto DENTRO del diseño, así
    // que ya NO los precargamos automáticamente (duplicaría el texto). Esta
    // función queda como una acción opcional ("+ Agregar textos del post")
    // por si el negocio quiere agregar alguno de estos como texto editable
    // extra — por ejemplo, para reforzar el CTA o agregarlo si la IA lo dejó
    // fuera. Usa una combinación de tipografías típica en diseño de
    // marketing: una fuente de impacto para el título, una legible para el
    // cuerpo, y algo con peso para el llamado a la acción.
    function addAllPostTexts() {
      let y = 36;
      if (editorData.headline) {
        addText(editorData.headline, {
          top: y,
          fontSize: 46,
          fontFamily: "Anton, sans-serif",
          fontWeight: "400",
        });
        y += 90;
      }
      if (editorData.keyMessage) {
        addText(editorData.keyMessage, {
          top: y,
          fontSize: 26,
          fontFamily: "Poppins, sans-serif",
          fontWeight: "500",
        });
        y += 70;
      }
      if (editorData.cta) {
        addText(editorData.cta, {
          top: DISPLAY_SIZE - 130,
          fontSize: 28,
          fontFamily: "Montserrat, sans-serif",
          fontWeight: "800",
          fill: "#FFFFFF",
        });
      }
      if (editorData.contactLine) {
        addText(editorData.contactLine, {
          top: DISPLAY_SIZE - 70,
          fontSize: 18,
          fontFamily: "Lato, sans-serif",
          fontWeight: "400",
        });
      }
      canvas.discardActiveObject();
      canvas.renderAll();
    }

    // Reconstruye exactamente lo que el negocio dejó guardado la última vez
    // (parches, textos, formas, íconos, logo) sobre el diseño — así puede
    // volver a editar sin tener que gastar otra generación de IA ni perder
    // su trabajo. Si nunca ha guardado nada, el lienzo arranca vacío sobre
    // el diseño tal como lo entregó la IA (ver comentario de addAllPostTexts).
    function restoreCanvasState(jsonStr) {
      let parsed;
      try {
        parsed = JSON.parse(jsonStr);
      } catch (err) {
        return;
      }
      const objects = (parsed && parsed.objects) || [];
      if (!objects.length) return;
      fabric.util.enlivenObjects(objects, function (enlivened) {
        enlivened.forEach(function (obj) { canvas.add(obj); });
        canvas.renderAll();
      });
    }

    function addLogo() {
      fabric.Image.fromURL(editorData.logoDataUri, function (img) {
        const logoWidth = 110;
        img.scaleToWidth(logoWidth);
        img.set({ left: (DISPLAY_SIZE - logoWidth) / 2, top: 20 });
        canvas.add(img);
        canvas.setActiveObject(img);
        canvas.renderAll();
      });
    }

    function addShape(type) {
      const color = document.getElementById("shape-color").value;
      let shape;
      switch (type) {
        case "rect":
          shape = new fabric.Rect({ left: 150, top: 150, width: 200, height: 120, fill: color });
          break;
        case "rrect":
          shape = new fabric.Rect({ left: 150, top: 150, width: 200, height: 120, rx: 24, ry: 24, fill: color });
          break;
        case "circle":
          shape = new fabric.Ellipse({ left: 150, top: 150, rx: 100, ry: 70, fill: color });
          break;
        case "line":
          shape = new fabric.Line([50, 50, 250, 50], { stroke: color, strokeWidth: 6 });
          break;
        case "arrow":
          shape = buildArrow(color);
          break;
        case "star":
          shape = buildStar(color);
          break;
        default:
          return;
      }
      canvas.add(shape);
      canvas.setActiveObject(shape);
      canvas.renderAll();
    }

    function buildArrow(color) {
      const points = [
        { x: 0, y: 20 }, { x: 120, y: 20 }, { x: 120, y: 0 }, { x: 170, y: 35 },
        { x: 120, y: 70 }, { x: 120, y: 50 }, { x: 0, y: 50 },
      ];
      return new fabric.Polygon(points, { left: 150, top: 200, fill: color });
    }

    function buildStar(color) {
      const spikes = 5;
      const outerRadius = 60;
      const innerRadius = 26;
      const points = [];
      for (let i = 0; i < spikes * 2; i++) {
        const radius = i % 2 === 0 ? outerRadius : innerRadius;
        const angle = (Math.PI / spikes) * i - Math.PI / 2;
        points.push({ x: outerRadius + radius * Math.cos(angle), y: outerRadius + radius * Math.sin(angle) });
      }
      return new fabric.Polygon(points, { left: 200, top: 200, fill: color });
    }

    // Íconos comunes en diseño de marketing (contacto y promociones), como
    // rutas vectoriales (Material Icons, licencia Apache 2.0 — libres de usar).
    // Se agregan con su color habitual, pero son formas normales: se pueden
    // recolorear, mover, redimensionar y borrar igual que cualquier otra.
    const ICONS = {
      location: {
        d: "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z",
        color: "#EA4335",
      },
      phone: {
        d: "M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z",
        color: "#1877F2",
      },
      whatsapp: {
        d: "M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z",
        color: "#25D366",
      },
      mail: {
        d: "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z",
        color: "#1877F2",
      },
      tag: {
        d: "M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.41l9 9c.36.36.86.59 1.41.59.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z",
        color: "#F59E0B",
      },
      clock: {
        d: "M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z",
        color: "#111111",
      },
      bolt: {
        d: "M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z",
        color: "#F59E0B",
      },
      check: {
        d: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z",
        color: "#22C55E",
      },
      cart: {
        d: "M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z",
        color: "#1877F2",
      },
      gift: {
        d: "M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z",
        color: "#D62976",
      },
      heart: {
        d: "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z",
        color: "#E11D48",
      },
      star: {
        d: "M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z",
        color: "#F59E0B",
      },
    };

    function addIcon(key) {
      const icon = ICONS[key];
      if (!icon) return;
      const path = new fabric.Path(icon.d, {
        left: 180,
        top: 180,
        fill: icon.color,
        scaleX: 2.2,
        scaleY: 2.2,
        shadow: "rgba(0,0,0,0.35) 0px 1px 4px",
      });
      canvas.add(path);
      canvas.setActiveObject(path);
      canvas.renderAll();
    }

    // --- Imágenes: subir desde archivo, pegar desde el portapapeles, y
    // quitar el fondo de la imagen seleccionada (ver /editor/remove-background,
    // que corre el modelo de IA localmente en el servidor). ---

    function addImageFromDataUrl(dataUrl) {
      fabric.Image.fromURL(dataUrl, function (img) {
        // La imagen entra a un tamaño razonable (no del tamaño original, que
        // puede ser enorme si viene de una foto de celular) para que se vea
        // completa dentro del lienzo y el negocio la reacomode a su gusto.
        const maxSize = 320;
        if (img.width > maxSize || img.height > maxSize) {
          const scale = maxSize / Math.max(img.width, img.height);
          img.scale(scale);
        }
        img.set({
          left: (DISPLAY_SIZE - img.getScaledWidth()) / 2,
          top: (DISPLAY_SIZE - img.getScaledHeight()) / 2,
        });
        canvas.add(img);
        canvas.setActiveObject(img);
        canvas.renderAll();
      });
    }

    function readFileAsImage(file) {
      if (!file || file.type.indexOf("image/") !== 0) return;
      const reader = new FileReader();
      reader.onload = function (e) { addImageFromDataUrl(e.target.result); };
      reader.readAsDataURL(file);
    }

    document.getElementById("btn-upload-image").addEventListener("click", function () {
      document.getElementById("image-file-input").click();
    });

    document.getElementById("image-file-input").addEventListener("change", function (e) {
      const file = e.target.files && e.target.files[0];
      readFileAsImage(file);
      e.target.value = ""; // permite volver a elegir el mismo archivo después
    });

    // Pegar imagen con Ctrl+V/Cmd+V. Si el negocio está escribiendo/editando
    // un texto en ese momento, dejamos que el pegado normal de texto ocurra
    // (no lo interceptamos) — solo tomamos el control si el portapapeles
    // trae una IMAGEN.
    document.addEventListener("paste", function (e) {
      const items = (e.clipboardData && e.clipboardData.items) || [];
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf("image/") === 0) {
          const file = items[i].getAsFile();
          if (file) {
            e.preventDefault();
            readFileAsImage(file);
          }
          return;
        }
      }
      // si no había imagen en el portapapeles, no hacemos nada especial —
      // el pegado de texto normal (si aplica) sigue su curso.
    });

    const btnRemoveBg = document.getElementById("btn-remove-bg");
    const removeBgStatus = document.getElementById("remove-bg-status");

    function updateRemoveBgAvailability() {
      const obj = canvas.getActiveObject();
      const isImage = Boolean(obj && obj.type === "image");
      btnRemoveBg.disabled = !isImage;
      if (isImage) {
        removeBgStatus.textContent = "Imagen seleccionada — puedes quitarle el fondo.";
      } else {
        removeBgStatus.textContent = "Selecciona una imagen en el lienzo para poder quitarle el fondo.";
      }
    }

    btnRemoveBg.addEventListener("click", function () {
      const obj = canvas.getActiveObject();
      if (!obj || obj.type !== "image") return;

      const sourceDataUrl = obj.toDataURL({ format: "png" });
      btnRemoveBg.disabled = true;
      removeBgStatus.textContent = "Quitando el fondo… puede tardar unos segundos.";

      fetch("/editor/remove-background", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ image: sourceDataUrl }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok) {
            removeBgStatus.textContent = data.error || "No se pudo quitar el fondo.";
            btnRemoveBg.disabled = false;
            return;
          }
          // setSrc conserva posición/tamaño/rotación del objeto; solo cambia
          // el contenido de la imagen por la versión ya recortada.
          obj.setSrc(data.image, function () {
            canvas.renderAll();
            removeBgStatus.textContent = "¡Listo! Fondo quitado.";
            btnRemoveBg.disabled = false;
          });
        })
        .catch(function () {
          removeBgStatus.textContent = "Ocurrió un error al quitar el fondo. Intenta de nuevo.";
          btnRemoveBg.disabled = false;
        });
    });

    // --- Filtros de imagen (brillo/contraste/saturación + preajustes) ---
    // Usa los filtros nativos de fabric.js (fabric.Image.filters.*), que ya
    // vienen incluidos con la librería — no se agrega ninguna dependencia
    // nueva. Se pueden aplicar a la foto de fondo (que no es un objeto
    // seleccionable normalmente, por eso el botón aparte) o a cualquier
    // imagen que el negocio haya subido/pegado y tenga seleccionada.
    let backgroundFilterMode = false;
    const filterTargetStatus = document.getElementById("filter-target-status");

    function getFilterTarget() {
      const obj = canvas.getActiveObject();
      if (obj && obj.type === "image") return obj;
      if (backgroundFilterMode && canvas.backgroundImage) return canvas.backgroundImage;
      return null;
    }

    function updateFilterTargetStatus() {
      const obj = canvas.getActiveObject();
      if (obj && obj.type === "image") {
        filterTargetStatus.textContent = "Editando: la imagen seleccionada.";
      } else if (backgroundFilterMode) {
        filterTargetStatus.textContent = "Editando: la foto de fondo.";
      } else {
        filterTargetStatus.textContent =
          "Selecciona una imagen en el lienzo, o usa el botón de arriba para editar la foto de fondo.";
      }
    }

    document.getElementById("btn-filter-target-bg").addEventListener("click", function () {
      canvas.discardActiveObject();
      canvas.renderAll();
      backgroundFilterMode = true;
      syncFilterSlidersToTarget();
      updateFilterTargetStatus();
    });

    // Cualquier selección de objeto (de lo que sea, no solo imágenes) sale
    // del "modo foto de fondo", para que no queden dos cosas activas a la vez.
    canvas.on("selection:created", function () { backgroundFilterMode = false; updateFilterTargetStatus(); });
    canvas.on("selection:updated", function () { backgroundFilterMode = false; updateFilterTargetStatus(); });
    canvas.on("selection:cleared", updateFilterTargetStatus);

    function syncFilterSlidersToTarget() {
      const target = getFilterTarget();
      const state = (target && target.__filterState) || { brightness: 0, contrast: 0, saturation: 0 };
      document.getElementById("filter-brightness").value = state.brightness;
      document.getElementById("filter-contrast").value = state.contrast;
      document.getElementById("filter-saturation").value = state.saturation;
    }

    // Reconstruye el arreglo de filtros del objetivo actual a partir de los
    // tres sliders (brillo/contraste/saturación) — mover cualquiera de los
    // tres siempre reemplaza cualquier preajuste anterior, para que el
    // resultado sea predecible.
    function applySliderFilters() {
      const target = getFilterTarget();
      if (!target) {
        filterTargetStatus.textContent =
          "Selecciona una imagen en el lienzo, o usa \"Editar la foto de fondo\", antes de ajustar filtros.";
        return;
      }
      const brightness = parseInt(document.getElementById("filter-brightness").value, 10) / 100;
      const contrast = parseInt(document.getElementById("filter-contrast").value, 10) / 100;
      const saturation = parseInt(document.getElementById("filter-saturation").value, 10) / 100;
      target.filters = [
        new fabric.Image.filters.Brightness({ brightness: brightness }),
        new fabric.Image.filters.Contrast({ contrast: contrast }),
        new fabric.Image.filters.Saturation({ saturation: saturation }),
      ];
      target.__filterState = { brightness: brightness * 100, contrast: contrast * 100, saturation: saturation * 100 };
      target.applyFilters();
      canvas.renderAll();
    }

    ["filter-brightness", "filter-contrast", "filter-saturation"].forEach(function (id) {
      document.getElementById(id).addEventListener("input", applySliderFilters);
    });

    // Preajustes: combinaciones fijas listas para un resultado rápido, al
    // estilo de los filtros de Instagram/Canva. Pisan cualquier ajuste
    // manual anterior (y reinician los sliders a 0, salvo que el preajuste
    // en sí sea de brillo/contraste/saturación, en cuyo caso reflejan ese
    // valor en los sliders para que se puedan seguir afinando).
    const FILTER_PRESETS = {
      ninguno: function (target) {
        target.filters = [];
        return { brightness: 0, contrast: 0, saturation: 0 };
      },
      vivido: function (target) {
        target.filters = [
          new fabric.Image.filters.Saturation({ saturation: 0.4 }),
          new fabric.Image.filters.Contrast({ contrast: 0.12 }),
        ];
        return { brightness: 0, contrast: 12, saturation: 40 };
      },
      bn: function (target) {
        target.filters = [new fabric.Image.filters.Grayscale()];
        return { brightness: 0, contrast: 0, saturation: 0 };
      },
      sepia: function (target) {
        target.filters = [new fabric.Image.filters.Sepia()];
        return { brightness: 0, contrast: 0, saturation: 0 };
      },
      calido: function (target) {
        target.filters = [
          new fabric.Image.filters.BlendColor({ color: "#FF9900", mode: "tint", alpha: 0.15 }),
          new fabric.Image.filters.Saturation({ saturation: 0.1 }),
        ];
        return { brightness: 0, contrast: 0, saturation: 10 };
      },
      frio: function (target) {
        target.filters = [
          new fabric.Image.filters.BlendColor({ color: "#0EA5E9", mode: "tint", alpha: 0.15 }),
        ];
        return { brightness: 0, contrast: 0, saturation: 0 };
      },
      contraste: function (target) {
        target.filters = [
          new fabric.Image.filters.Contrast({ contrast: 0.3 }),
          new fabric.Image.filters.Saturation({ saturation: 0.1 }),
        ];
        return { brightness: 0, contrast: 30, saturation: 10 };
      },
      nitida: function (target) {
        target.filters = [
          new fabric.Image.filters.Convolute({ matrix: [0, -1, 0, -1, 5, -1, 0, -1, 0] }),
        ];
        return { brightness: 0, contrast: 0, saturation: 0 };
      },
      suave: function (target) {
        target.filters = [new fabric.Image.filters.Blur({ blur: 0.12 })];
        return { brightness: 0, contrast: 0, saturation: 0 };
      },
    };

    document.querySelectorAll("[data-filter-preset]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const target = getFilterTarget();
        if (!target) {
          filterTargetStatus.textContent =
            "Selecciona una imagen en el lienzo, o usa \"Editar la foto de fondo\", antes de aplicar un filtro.";
          return;
        }
        const preset = FILTER_PRESETS[btn.getAttribute("data-filter-preset")];
        if (!preset) return;
        const sliderState = preset(target);
        target.__filterState = sliderState;
        target.applyFilters();
        canvas.renderAll();
        syncFilterSlidersToTarget();
      });
    });

    // Punto de partida cuando el negocio entra por primera vez (sin edición
    // guardada): arma, ENCIMA de la foto de la IA, un layout ya "diseñado" —
    // logo, título, una insignia circular con texto editable, una barra de
    // WhatsApp/CTA, y — separado, en su propio recuadro — la dirección/contacto.
    // Cada pieza es un objeto real e independiente (círculo, texto, rectángulo,
    // imagen), no un solo bloque de píxeles. Así el negocio puede mover el
    // círculo, editar el texto o cambiar el color de cada barra por separado,
    // sin tener que regenerar nada.
    function buildDefaultLayout() {
      if (editorData.logoDataUri) {
        addLogo();
      }

      if (editorData.headline) {
        addText(editorData.headline, {
          left: 40,
          top: 140,
          width: DISPLAY_SIZE - 80,
          fontSize: 34,
          fontFamily: "Anton, sans-serif",
          fontWeight: "400",
        });
      }

      // Insignia circular con la oferta. Si se pudo detectar un descuento
      // concreto en el brief (ej. "-50%", "2x1", "¡GRATIS!"), arranca ya
      // escrito y listo — el negocio solo la mueve/recolorea si quiere. Si no
      // se detectó nada, arranca con un placeholder marcado con ✏️ y un
      // borde punteado, a propósito bien visible, para que sea obvio que hay
      // que reemplazarlo antes de guardar (btn-save valida esto, ver abajo).
      const badgeColor = editorData.brandColorPrimary || "#1877F2";
      const hasRealOffer = Boolean(editorData.offerBadge);
      const badgeText = hasRealOffer ? editorData.offerBadge : PLACEHOLDER_MARK + " Tu oferta aquí";
      const badge = new fabric.Circle({
        left: 50,
        top: 230,
        radius: 70,
        fill: badgeColor,
        stroke: hasRealOffer ? null : "#FFFFFF",
        strokeWidth: hasRealOffer ? 0 : 3,
        strokeDashArray: hasRealOffer ? null : [8, 6],
      });
      canvas.add(badge);
      addText(badgeText, {
        left: 60,
        top: hasRealOffer ? 288 : 268,
        width: 120,
        fontSize: hasRealOffer ? 28 : 16,
        fontFamily: "Montserrat, sans-serif",
        fontWeight: "800",
        fill: "#FFFFFF",
        shadow: null,
      });

      // Barra de CTA (WhatsApp) — su propio recuadro, independiente y recolorable.
      const barColor = editorData.brandColorPrimary || "#1877F2";
      const bar = new fabric.Rect({ left: 0, top: 452, width: DISPLAY_SIZE, height: 55, fill: barColor });
      canvas.add(bar);

      const waIcon = new fabric.Path(ICONS.whatsapp.d, {
        left: 24,
        top: 465,
        fill: "#FFFFFF",
        scaleX: 1.2,
        scaleY: 1.2,
