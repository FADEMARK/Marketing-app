<!DOCTYPE html>
<html lang="es">
<head>
  <title>Nuevo: <%= title %></title>
  <%- include('partials/head') %>
</head>
<body class="erp-shell">
  <%- include('partials/erp-header') %>

  <main class="page narrow">
    <a href="/erp/core/<%= flow %>/<%= docType %>" class="back-link">&larr; Volver a <%= title %></a>
    <h1>Nuevo: <%= title %></h1>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (items.length === 0) { %>
      <div class="empty-state">
        <p>Todavía no tienes artículos activos en tu catálogo.</p>
        <a href="/erp/inventario/articulos/new" class="btn-primary">+ Nuevo artículo</a>
      </div>
    <% } else { %>
      <form method="POST" action="/erp/core/<%= flow %>/<%= docType %>" class="card-form">
        <div class="detail-box" style="position:relative;">
          <h3><%= flow === 'ventas' ? 'Cliente' : 'Proveedor' %></h3>
          <label>Nombre (se autocompleta si ya existe, o se da de alta)
            <input type="text" id="entity-name-input" name="<%= flow === 'ventas' ? 'client_name' : 'vendor_name' %>" autocomplete="off" placeholder="Nombre" />
          </label>
          <input type="hidden" id="entity-id-input" name="<%= flow === 'ventas' ? 'client_id' : 'vendor_id' %>" value="" />
          <div id="entity-suggestions" class="muted small" style="display:none; border:1px solid var(--border); border-radius:6px; margin-top:-8px; background:#fff;"></div>
          <div class="two-col">
            <label>Teléfono
              <input type="text" id="entity-phone-input" name="<%= flow === 'ventas' ? 'client_phone' : 'vendor_phone' %>" />
            </label>
            <label>Correo
              <input type="email" id="entity-email-input" name="<%= flow === 'ventas' ? 'client_email' : 'vendor_email' %>" />
            </label>
          </div>
        </div>

        <div class="detail-box">
          <h3>Moneda y ubicación</h3>
          <div class="two-col">
            <label>Moneda
              <select name="currency_code" id="tc-currency-select">
                <option value="">— Moneda base —</option>
                <% currencies.forEach(function(c) { %>
                  <option value="<%= c.code %>"><%= c.code %> — <%= c.name %></option>
                <% }); %>
              </select>
            </label>
            <label>Tipo de cambio (manual, ej. valor DOF del día)
              <div style="display:flex; gap:8px;">
                <input type="number" name="exchange_rate" id="tc-exchange-rate" step="0.000001" min="0" value="1" style="flex:1;" />
                <button type="button" id="tc-suggest-btn" class="btn-secondary" style="white-space:nowrap;">💱 Sugerir</button>
              </div>
            </label>
          </div>
          <p class="muted small" id="tc-suggest-note" style="display:none;"></p>
          <label>Ubicación<%= isExecution ? ' (obligatoria para ejecutar el pedido)' : ' (opcional)' %>
            <select name="location_id" <%= isExecution ? 'required' : '' %>>
              <option value="">— Sin ubicación —</option>
              <% locations.forEach(function(loc) { %>
                <option value="<%= loc.id %>"><%= loc.name %></option>
              <% }); %>
            </select>
          </label>
        </div>

        <div class="detail-box">
          <h3>Artículos</h3>
          <p class="muted small">
            El impuesto de cada línea se sugiere del artículo, pero puedes cambiarlo solo para esta
            transacción (no modifica el catálogo).
          </p>
          <% items.forEach(function(it) { %>
            <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); flex-wrap:wrap;">
              <input type="checkbox" name="item_ids" value="<%= it.id %>" id="item-<%= it.id %>" style="width:auto;" />
              <label for="item-<%= it.id %>" style="flex:1; min-width:160px; font-weight:400; margin:0;">
                <%= it.name %> <span class="muted small"><%= it.sku ? '(' + it.sku + ')' : '' %></span>
              </label>
              <input type="number" name="qty_<%= it.id %>" step="0.01" min="0.01" value="1" placeholder="Cant." style="width:80px;" />
              <input type="number" name="price_<%= it.id %>" step="0.01" min="0" placeholder="Precio"
                     value="<%= flow === 'ventas' ? it.price : it.cost %>" style="width:110px;" />
              <select name="tax_id_<%= it.id %>" style="width:150px;" title="Impuesto de esta línea">
                <option value="" <%= !it.tax_id ? 'selected' : '' %>>Sin impuesto</option>
                <% taxes.forEach(function(t) { %>
                  <option value="<%= t.id %>" <%= it.tax_id === t.id ? 'selected' : '' %>>
                    <%= t.name %> (<%= Number(t.rate).toString() %>%)
                  </option>
                <% }); %>
              </select>
            </div>
          <% }); %>
        </div>

        <label>Notas
          <textarea name="notes" rows="2"></textarea>
        </label>

        <%- include('partials/custom-fields-inputs', { customFieldDefs, customFieldValues }) %>

        <button type="submit" class="btn-primary full-width">Guardar</button>
      </form>
    <% } %>
  </main>

  <script>
    (function() {
      var nameInput = document.getElementById('entity-name-input');
      var idInput = document.getElementById('entity-id-input');
      var phoneInput = document.getElementById('entity-phone-input');
      var emailInput = document.getElementById('entity-email-input');
      var box = document.getElementById('entity-suggestions');
      var timer = null;
      var autocompleteUrl = <%- flow === 'ventas' ? "'/erp/clientes-autocomplete'" : "'/erp/proveedores-autocomplete'" %>;

      if (!nameInput) return;

      nameInput.addEventListener('input', function() {
        idInput.value = '';
        var q = nameInput.value.trim();
        clearTimeout(timer);
        if (q.length < 2) { box.style.display = 'none'; box.innerHTML = ''; return; }
        timer = setTimeout(function() {
          fetch(autocompleteUrl + '?q=' + encodeURIComponent(q))
            .then(function(r) { return r.json(); })
            .then(function(list) {
              if (!list.length) { box.style.display = 'none'; box.innerHTML = ''; return; }
              box.innerHTML = list.map(function(c) {
                return '<div class="entity-suggestion" data-id="' + c.id + '" data-name="' + c.name.replace(/"/g, '&quot;') +
                  '" data-phone="' + (c.phone || '') + '" data-email="' + (c.email || '') +
                  '" style="padding:6px 8px; cursor:pointer;">' + c.name + (c.phone ? ' — ' + c.phone : '') + '</div>';
              }).join('');
              box.style.display = 'block';
            })
            .catch(function() { box.style.display = 'none'; });
        }, 250);
      });

      box.addEventListener('click', function(ev) {
        var target = ev.target.closest('.entity-suggestion');
        if (!target) return;
        idInput.value = target.getAttribute('data-id');
        nameInput.value = target.getAttribute('data-name');
        phoneInput.value = target.getAttribute('data-phone') || '';
        emailInput.value = target.getAttribute('data-email') || '';
        box.style.display = 'none';
        box.innerHTML = '';
      });

      document.addEventListener('click', function(ev) {
        if (ev.target !== nameInput && !box.contains(ev.target)) {
          box.style.display = 'none';
        }
      });
    })();

    // Botón "Sugerir tipo de cambio" (Moneda > sugerencia de referencia).
    // Nunca sobreescribe el campo sin que el usuario lo pida — solo llena el
    // valor al hacer clic, el usuario lo puede seguir editando a mano igual
    // que siempre.
    (function() {
      var btn = document.getElementById('tc-suggest-btn');
      var currencySelect = document.getElementById('tc-currency-select');
      var rateInput = document.getElementById('tc-exchange-rate');
      var note = document.getElementById('tc-suggest-note');
      if (!btn) return;

      btn.addEventListener('click', function() {
        var currency = currencySelect.value;
        if (!currency) {
          note.textContent = 'Elige primero una moneda distinta a la base para pedir una sugerencia.';
          note.style.display = 'block';
          return;
        }
        btn.disabled = true;
        btn.textContent = 'Consultando...';
        fetch('/erp/tipo-cambio-sugerido?currency=' + encodeURIComponent(currency))
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.ok) {
              rateInput.value = data.rate;
              note.textContent = data.note || ('Sugerido: ' + data.rate);
            } else {
              note.textContent = data.error || 'No se pudo obtener una sugerencia.';
            }
            note.style.display = 'block';
          })
          .catch(function() {
            note.textContent = 'No se pudo consultar un tipo de cambio de referencia. Captúralo manualmente.';
            note.style.display = 'block';
          })
          .finally(function() {
            btn.disabled = false;
            btn.textContent = '💱 Sugerir';
          });
      });
    })();
  </script>
</body>
</html>
