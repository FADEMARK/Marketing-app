<!DOCTYPE html>
<html lang="es">
<head>
  <title>Configuración de transacciones — YonkSuite</title>
  <%- include('partials/head') %>
</head>
<body class="erp-shell">
  <%- include('partials/erp-header', { currentSection: 'configuracion' }) %>

  <main class="form-page">
    <a href="/erp/configuracion" class="back-link">&larr; Volver a Configuración</a>
    <h1>Configuración de transacciones</h1>
    <p class="muted small">
      Define el prefijo y el siguiente número consecutivo para identificar cada documento
      (por ejemplo, FAC-0001, FAC-0002...). Cambiar el número solo afecta a los folios nuevos.
    </p>

    <% if (saved) { %>
      <div class="alert alert-success">Cambios guardados.</div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/erp/configuracion/transacciones" class="card-form">
      <% DOC_TYPE_GROUPS.forEach(function(group, gIdx) { %>
        <div style="<%= gIdx < DOC_TYPE_GROUPS.length - 1 ? 'border-bottom: 1px solid var(--border); padding-bottom: 12px;' : '' %> padding-top: 4px;">
          <h3 style="margin-top:0;"><%= group.label %></h3>
          <% group.types.forEach(function(type) { %>
            <div class="two-col" style="margin-bottom:8px;">
              <label><%= DOC_TYPE_LABELS[type] %> — Prefijo
                <input type="text" name="prefix_<%= type %>" value="<%= numbering[type].prefix %>" maxlength="10" />
              </label>
              <label>Siguiente número
                <input type="number" name="next_<%= type %>" min="1" value="<%= numbering[type].nextNumber %>" />
              </label>
            </div>
          <% }); %>
        </div>
      <% }); %>

      <button type="submit" class="btn-primary full-width">Guardar cambios</button>
    </form>
  </main>
</body>
</html>
